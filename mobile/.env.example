# Copy to `.env` and adjust. All vars must be prefixed EXPO_PUBLIC_ to be
# readable at runtime.

# Backend base URL.
#   Android emulator → http://10.0.2.2:4000  (host loopback)
#   Real phone       → http://<your-PC-LAN-IP>:4000  e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Device id used when relaying telemetry (keep in sync with the DB / web dashboard).
EXPO_PUBLIC_DEVICE_ID=arduino-uno

# Set to true to run the UI with a simulated Bluetooth device (no hardware needed).
EXPO_PUBLIC_USE_MOCK_BT=false

# Set to false for fully-offline direct-Bluetooth mode (no backend calls at all).
EXPO_PUBLIC_RELAY_TO_BACKEND=true
